#!/bin/sh
# Refuse le push tant que la règle de la maison n'est pas respectée.
# Posé par `ses adopter` (git config core.hooksPath .githooks).
if ! command -v ses >/dev/null 2>&1; then
  echo "ses introuvable : pnpm add -g @skymdev-technologies/ses, ou un alias vers SES/scripts/ses.mjs" >&2
  exit 1
fi
exec ses verifier .
